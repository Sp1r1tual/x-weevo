# ==============================================================================
# Auth.js (Google OAuth)
# Generate AUTH_SECRET with: npx auth secret
# Get Google credentials at: https://console.cloud.google.com/
# ==============================================================================

# A random secret used to sign/encrypt tokens (generate with: npx auth secret)
AUTH_SECRET=

# Google OAuth credentials (from Google Cloud Console → Credentials → OAuth 2.0)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ==============================================================================
# Database Configuration (Prisma)
# ==============================================================================

# Database connection string used for general runtime queries.
# Use the "Transaction" mode connection string (often port 6543)
DATABASE_URL=

# Database connection string used ONLY for Prisma migrations.
# Use the "Session" mode connection string (often port 5432)
DIRECT_URL=


# ==============================================================================
# Supabase Configuration (Storage only — for image uploads)
# You can find these in your Supabase Dashboard: Project Settings -> API
# NOTE: These are NOT used for authentication.
# ==============================================================================

# Your project URL (e.g., https://xxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Server-only secret key for admin image uploads. Never expose it to the browser
# and never add the NEXT_PUBLIC_ prefix. Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=


# ==============================================================================
# General Configuration
# ==============================================================================

# Site URL for SEO, metadata, sitemaps, etc. (e.g., http://localhost:3000 in dev, or your production URL)
NEXT_PUBLIC_SITE_URL=